{
    "name": "sanchescom/php-wifi",
    "description": "Cross-platform PHP library for scanning and joining Wi-Fi networks (Linux/nmcli, macOS/networksetup, Windows/netsh).",
    "type": "library",
    "keywords": ["wifi", "wireless", "nmcli", "networksetup", "netsh", "raspberry-pi"],
    "homepage": "https://github.com/sanchescom/php-wifi",
    "license": "MIT",
    "authors": [
        {"name": "Aleksandr Efimov", "email": "sanches.com@mail.ru"}
    ],
    "require": {
        "php": "^8.2",
        "illuminate/collections": "^11.0 || ^12.0 || ^13.0",
        "phplucidframe/console-table": "^1.3",
        "splitbrain/php-cli": "^1.3"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "files": [
            "src/Helpers/array.php",
            "src/Helpers/string.php",
            "src/Helpers/calculate.php"
        ],
        "psr-4": {"Sanchescom\\WiFi\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Sanchescom\\WiFi\\Test\\": "tests/"}
    },
    "bin": ["bin/wifi"],
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "lint": "./vendor/bin/phpcs -p --standard=PSR12 ./src",
        "fix": "./vendor/bin/phpcbf --standard=PSR12 ./src",
        "analyse": "./vendor/bin/phpstan analyse",
        "analyse:new": "./vendor/bin/phpstan analyse --level=max src/Shell"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
