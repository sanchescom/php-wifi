{
    "name": "sanchescom/php-wifi",
    "description": "Cross-platform PHP library for Wi-Fi: scan, join, known networks, and on Linux a hotspot and a watchdog that keeps a headless device (Raspberry Pi) online.",
    "type": "library",
    "keywords": ["wifi", "wireless", "hotspot", "access-point", "hostapd", "wpa-supplicant", "wpa-cli", "nmcli", "networkmanager", "networksetup", "netsh", "raspberry-pi", "iot", "headless", "provisioning", "watchdog", "cli"],
    "homepage": "https://github.com/sanchescom/php-wifi",
    "license": "MIT",
    "authors": [
        {"name": "Aleksandr Efimov", "email": "sanches.com@mail.ru"}
    ],
    "require": {
        "php": "^8.2",
        "illuminate/collections": "^11.0 || ^12.0 || ^13.0",
        "phplucidframe/console-table": "^1.3",
        "splitbrain/php-cli": "^1.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {"Sanchescom\\WiFi\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Sanchescom\\WiFi\\Test\\": "tests/"}
    },
    "bin": ["bin/wifi"],
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "lint": "./vendor/bin/phpcs -p --standard=PSR12 ./src ./examples",
        "fix": "./vendor/bin/phpcbf --standard=PSR12 ./src ./examples",
        "analyse": "./vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
