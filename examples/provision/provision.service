[Unit]
Description=Headless Wi-Fi provisioning hotspot for php-wifi
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
User=www-data
EnvironmentFile=/etc/php-wifi-provision.env
ExecStart=/usr/bin/env bash /opt/php-wifi/examples/provision/hotspot.sh
Restart=on-failure
RestartSec=30
# On a machine without NetworkManager the page starts the DHCP client for the
# join. It must outlive this unit, or the device loses its address the moment
# the run ends.
KillMode=process
RuntimeDirectory=php-wifi-provision
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
