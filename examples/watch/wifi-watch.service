[Unit]
Description=php-wifi watchdog: keep this device joined to Wi-Fi, raising a provisioning hotspot when it cannot
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/php-wifi-watch.env
ExecStart=/opt/php-wifi/bin/wifi watch --hotspot-ssid=${WATCH_HOTSPOT_SSID} --hotspot-password-file=${WATCH_HOTSPOT_PASSWORD_FILE} --interval=${WATCH_INTERVAL} --retry=${WATCH_RETRY}
Restart=always
RestartSec=10
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
